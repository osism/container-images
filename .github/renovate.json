{
  "extends": [
    "github>osism/renovate-config",
    "github>osism/renovate-config:docker",
    "github>osism/renovate-config:python"
  ],
  "regexManagers":[
    {
      "fileMatch":[
        "^\\.github\\/workflows\\/build-.*\\.yml"
      ],
      "matchStrings":[
        "- (?<currentValue>.*?)  # renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\n"
     ]
    }
  ],
  "packageRules": [
    {
      "matchPaths": ["netbox/requirements.txt", "netbox/Containerfile", ".github/workflows/build-netbox-container-image.yml"],
      "groupName": "netbox"
    },
    {
      "description": "Bump tempest and its plugins in one PR, so the constraints refresh that a tempest bump triggers covers the plugins too",
      "matchFileNames": ["tempest/files/requirements.txt"],
      "matchPackageNames": ["tempest", "/-tempest-plugin$/"],
      "groupName": "tempest"
    }
  ]
}
