ARG VERSION=2025.2
FROM registry.osism.tech/kolla/cinder-volume:${VERSION}

ARG VERSION

USER root

# Huawei driver
RUN set -e && \
    case "${VERSION}" in \
        2024.2) HUAWEI_BRANCH="Dalmatian" ;; \
        2025.1) HUAWEI_BRANCH="Epoxy" ;; \
        2025.2) HUAWEI_BRANCH="Flamingo" ;; \
        *) echo "Unsupported VERSION: ${VERSION}" && exit 1 ;; \
    esac && \
    # Find Python version dynamically
    PYTHON_VERSION=$(python3 -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')") && \
    HUAWEI_DIR="/var/lib/kolla/venv/lib/python${PYTHON_VERSION}/site-packages/cinder/volume/drivers/huawei" && \
    echo "Installing Huawei drivers from branch ${HUAWEI_BRANCH} to ${HUAWEI_DIR}" && \
    # Remove old driver files
    rm -rf "${HUAWEI_DIR}"/* && \
    # Fetch the driver tree as one tarball from codeload. Unlike the
    # contents API, codeload is not subject to the unauthenticated limit
    # of 60 requests per hour, which shared runner IPs often exhaust.
    curl -fsSL "https://codeload.github.com/Huawei/OpenStack_Driver/tar.gz/refs/heads/master" \
        -o /tmp/huawei-driver.tar.gz && \
    tar -xzf /tmp/huawei-driver.tar.gz -C "${HUAWEI_DIR}" \
        --no-same-owner --no-same-permissions \
        --strip-components=3 --wildcards \
        "OpenStack_Driver-master/Cinder/${HUAWEI_BRANCH}/*.py" && \
    rm -f /tmp/huawei-driver.tar.gz && \
    echo "Installed files: $(ls "${HUAWEI_DIR}" | tr '\n' ' ')"

# LINBIT LINSTOR driver
RUN set -e && \
    PYTHON_VERSION=$(python3 -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')") && \
    DRIVERS_DIR="/var/lib/kolla/venv/lib/python${PYTHON_VERSION}/site-packages/cinder/volume/drivers" && \
    LINSTOR_BRANCH="linstor/stable/${VERSION}" && \
    echo "Installing LINSTOR driver from branch ${LINSTOR_BRANCH}" && \
    curl -fsSL "https://raw.githubusercontent.com/LINBIT/openstack-cinder/${LINSTOR_BRANCH}/cinder/volume/drivers/linstordrv.py" \
        -o "${DRIVERS_DIR}/linstordrv.py" && \
    /var/lib/kolla/venv/bin/pip install --no-cache-dir python-linstor

USER cinder
