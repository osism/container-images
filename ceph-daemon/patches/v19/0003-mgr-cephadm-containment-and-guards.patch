+            for ifaces in networks.values()
+            for iface, ips in ifaces.items()
+            for ip in ips
+        })
+        for subnet in subnets:
+            network = ipaddress.ip_network(subnet)
+            for _, ip in candidates:
+                if ipaddress.ip_address(ip) in network:
+                    return ip
