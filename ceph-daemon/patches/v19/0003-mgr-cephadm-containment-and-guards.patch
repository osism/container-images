+def is_single_host_network(subnet: str) -> bool:
+    """True for a /32 or /128 key of the host network map.
+
+    Such a key describes exactly one address. It can satisfy a containment
+    test without demonstrating that the interface can carry a *different*
+    address -- a VIP, for instance -- so consumers that are really asking
+    about interface suitability must skip it.
+    """
+    net = ipaddress.ip_network(subnet)
+    return net.prefixlen == net.max_prefixlen
+
