+def _parse_ip_addr(out: str, keyword: str) -> Dict[str, Dict[str, Set[str]]]:
+    # An address is discoverable through `ip route ls` only when some route
+    # advertises it as a preferred source, so an address carrying a host
+    # prefix on a dummy or loopback device is invisible there although it is
+    # configured, bindable and answering. Register each configured address as
+    # a single-host network, which is a shape this map already has: the route
+    # parser normalises a bare destination the same way.
+    r = {}  # type: Dict[str, Dict[str, Set[str]]]
+    iface_p = re.compile(r'^\d+: (\S+?)(?:@\S+)?: <(\S*)>')
+    addr_p = re.compile(r'^\s+%s (\S+?)/(?:\d+) ?(.*)$' % keyword)
+    iface = None  # type: Optional[str]
+    admin_up = False
+    for line in out.splitlines():
+        m = iface_p.match(line)
+        if m:
+            iface = m.group(1)
+            # IFF_UP, the administrative flag -- deliberately not the
+            # operational state: dummy and loopback devices report
+            # `state UNKNOWN` while carrying perfectly bindable addresses.
+            admin_up = 'UP' in m.group(2).split(',')
+            continue
+        m = addr_p.match(line)
+        if not m or iface is None or not admin_up:
+            continue
+        ip = m.group(1)
+        flags = m.group(2).split()
+        # Duplicate address detection may still be running, or may have
+        # failed; either way the address cannot be bound yet.
+        if 'tentative' in flags or 'dadfailed' in flags:
+            continue
+        addr = ipaddress.ip_address(ip)
+        # Link-local addresses need an interface scope this map cannot
+        # carry, and loopback answers are synthesised from the subnet by
+        # consumers that want them.
+        if addr.is_loopback or addr.is_link_local:
+            continue
+        net = '%s/%d' % (ip, addr.max_prefixlen)
+        r.setdefault(net, {}).setdefault(iface, set()).add(ip)
+    return r
+
+
+def _parse_ipv4_addr(out: str) -> Dict[str, Dict[str, Set[str]]]:
+    return _parse_ip_addr(out, 'inet')
+
+
+def _parse_ipv6_addr(out: str) -> Dict[str, Dict[str, Set[str]]]:
+    return _parse_ip_addr(out, 'inet6')
+
